    "version": "2.0.0",
    "tasks": [
        {
            "label": "just deploy",
            "type": "shell",
            "command": "just",
            "args": [
                "deploy"
            ],
            "options": {
                "env": {
                    "CICS_PASSWORD": "${input:password}"
                }
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "password",
            "description": "Password:",
            "default": "",
            "type": "promptString",
            "password": true
        },
    ]
}
